{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "FlowLens desktop permissions",
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "windows": ["main", "floating", "settings"],
  "permissions": ["allow-flowlens-ui", "core:default", "core:window:default", "core:event:default", "core:window:allow-start-dragging", "core:window:allow-show", "core:window:allow-hide", "core:window:allow-set-focus"]
}
