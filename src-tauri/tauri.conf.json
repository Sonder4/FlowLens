{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlassNet",
  "version": "0.1.0",
  "identifier": "com.glassnet.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GlassNet — 网络流量监控",
        "url": "dashboard.html",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 660,
        "transparent": true,
        "decorations": true,
        "windowEffects": {
          "effects": [
            "acrylic"
          ],
          "color": "#eef1f640"
        }
      },
      {
        "label": "floating",
        "title": "GlassNet",
        "url": "floating.html",
        "width": 150,
        "height": 76,
        "x": 40,
        "y": 40,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "GlassNet 设置",
        "url": "settings.html",
        "width": 440,
        "height": 600,
        "visible": false,
        "resizable": false,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "acrylic"
          ],
          "color": "#eef1f640"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}